   "source": [
    "principal = int(input(\"P($):\"))\n",
    "rate = int(input(\"R(%):\"))/100\n",
    "number_of_years = int(input(\"N:\"))\n",
    "time = int(input(\"T:\"))\n",
    "\n",
    "calc1 = 1 +(rate / number_of_years)\n",
    "calc2 = calc1 ** (number_of_years * time)\n",
    "calc3 = principal * calc2\n",
    "print(f\"Amount:{calc3}\")"
   ]
